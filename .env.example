DB_HOST=localhost
DB_PORT=5434
DB_USER=nest_user
DB_PASSWORD=nest_password
DB_NAME=store_db
PORT=3000

# JWT: окремі секрети для access та refresh токенів
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# Облікові записи привілейованих ролей для npm run seed:users
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=Manager12345
